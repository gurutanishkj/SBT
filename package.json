{
  "name": "sbt-cinemas-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:server": "npm.cmd --prefix server run dev",
    "dev:client": "npm.cmd --prefix client run dev",
    "dev": "concurrently \"npm.cmd run dev:server\" \"npm.cmd run dev:client\"",
    "build:server": "npm.cmd --prefix server run build",
    "build:client": "npm.cmd --prefix client run build",
    "build": "npm.cmd run build:server && npm.cmd run build:client",
    "seed": "npm.cmd --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
